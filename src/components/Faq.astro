---
import { t } from '../i18n/es';
import { faqs } from '../data/faq';
import SectionHeading from './SectionHeading.astro';
---

<section id="faq" aria-labelledby="faq-heading" class="py-20 sm:py-28">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <SectionHeading
      id="faq-heading"
      kicker={t.faq.kicker}
      title={t.faq.title}
      intro={t.faq.intro}
    />
    <div class="mt-12 space-y-4">
      {faqs.map((item, i) => (
        <div
          data-accordion="closed"
          class="rounded-2xl border border-white/10 bg-coal-900 transition-colors has-[button[aria-expanded='true']]:border-yolk-400/40"
        >
          <h3 class="font-display text-lg tracking-wide">
            <button
              type="button"
              aria-expanded="false"
              aria-controls={`faq-panel-${i}`}
              id={`faq-button-${i}`}
              class="flex w-full items-center justify-between gap-4 px-6 py-5 text-left uppercase"
            >
              <span>{item.question}</span>
              <svg
                data-accordion-icon
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                aria-hidden="true"
                class="shrink-0 text-yolk-400"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </button>
          </h3>
          <div
            data-accordion-panel
            id={`faq-panel-${i}`}
            role="region"
            aria-labelledby={`faq-button-${i}`}
          >
            <div>
              <p class="px-6 pb-6 leading-relaxed text-white/70">{item.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
