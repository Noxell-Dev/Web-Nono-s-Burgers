---
import { t } from '../i18n/es';
import { reviews } from '../data/reviews';
import SectionHeading from './SectionHeading.astro';

function stars(count: number): number[] {
  return Array.from({ length: count }, (_, i) => i);
}
---

<section id="resenas" aria-labelledby="resenas-heading" class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading
      id="resenas-heading"
      kicker={t.reviews.kicker}
      title={t.reviews.title}
      intro={t.reviews.intro}
    />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {reviews.map((review) => (
        <figure class="flex flex-col rounded-2xl border border-white/10 bg-coal-900 p-7">
          <div class="mb-4 flex gap-1" role="img" aria-label={`${review.stars} de 5 estrellas`}>
            {stars(review.stars).map(() => (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-yolk-400" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" />
              </svg>
            ))}
          </div>
          <blockquote class="flex-1 leading-relaxed text-white/80">
            “{review.text}”
          </blockquote>
          <figcaption class="mt-5 flex items-center gap-3">
            <span aria-hidden="true" class="flex h-10 w-10 items-center justify-center rounded-full bg-leaf-400/15 font-display text-lg text-leaf-300">
              {review.name.charAt(0)}
            </span>
            <span class="font-bold">{review.name}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
