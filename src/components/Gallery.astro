---
import { t } from '../i18n/es';
import { galleryImages } from '../data/gallery';
import SectionHeading from './SectionHeading.astro';
---

<section id="fotos" aria-labelledby="fotos-heading" class="bg-coal-900 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading
      id="fotos-heading"
      kicker={t.gallery.kicker}
      title={t.gallery.title}
      intro={t.gallery.intro}
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {galleryImages.map((image) => (
        <figure class="group overflow-hidden rounded-2xl border border-white/10 bg-coal-950">
          <img
            src={image.src}
            width={image.width}
            height={image.height}
            alt={image.alt}
            loading="lazy"
            class="h-auto w-full transition-transform duration-300 group-hover:scale-[1.02]"
          />
        </figure>
      ))}
    </div>
  </div>
</section>
