---
import { t } from '../i18n/es';
import { site } from '../data/site';

const [mainPhone] = site.phones;
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/#inicio" class="flex items-center gap-3" aria-label={`${t.siteName} - inicio`}>
      <img
        src="/images/logo.jpg"
        width="40"
        height="40"
        alt=""
        class="h-10 w-10 rounded-full object-cover"
      />
      <span class="font-display text-xl tracking-wide uppercase">
        Nono's <span class="text-yolk-400">Burgers</span>
      </span>
    </a>

    <nav aria-label="Navegación principal" class="hidden md:block">
      <ul class="flex items-center gap-7">
        {t.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm font-medium text-white/80 transition-colors hover:text-yolk-400"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={mainPhone.href}
        class="hidden items-center gap-2 rounded-full bg-yolk-400 px-5 py-2.5 text-sm font-bold text-coal-950 transition-transform hover:scale-105 sm:inline-flex"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        {t.callCta}
      </a>
      <button
        id="nav-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-white/15 text-white md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.openMenu}
        data-open-label={t.openMenu}
        data-close-label={t.closeMenu}
      >
        <svg data-icon-open width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg data-icon-close class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    hidden
    aria-label="Navegación móvil"
    class="border-t border-white/10 bg-coal-950/95 backdrop-blur-md md:hidden"
  >
    <ul class="space-y-1 px-4 py-4">
      {t.nav.map((item) => (
        <li>
          <a
            href={item.href}
            class="block rounded-lg px-3 py-3 text-base font-medium text-white/85 hover:bg-white/5 hover:text-yolk-400"
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <a
          href={mainPhone.href}
          class="flex items-center justify-center gap-2 rounded-full bg-yolk-400 px-5 py-3 text-base font-bold text-coal-950"
        >
          {t.callCta}: {mainPhone.display}
        </a>
      </li>
    </ul>
  </nav>
</header>
