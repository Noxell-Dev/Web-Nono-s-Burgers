---
import { t } from '../i18n/es';

/* Cinta decorativa con las especialidades. Se duplica la lista para
   el bucle infinito; la copia es aria-hidden. */
---

<div class="overflow-hidden border-y-4 border-coal-950 bg-yolk-400 py-3" aria-hidden="true">
  <div class="marquee-track flex w-max items-center gap-8 whitespace-nowrap">
    {[0, 1].map((copy) => (
      <div class="flex items-center gap-8" aria-hidden={copy === 1 ? 'true' : undefined}>
        {t.marquee.map((item) => (
          <span class="flex items-center gap-8 font-display text-lg tracking-wider text-coal-950 uppercase">
            {item}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z" />
            </svg>
          </span>
        ))}
      </div>
    ))}
  </div>
</div>
