---
interface Props {
  kicker: string;
  title: string;
  intro?: string;
  /** Id del h2, para referenciarlo con aria-labelledby desde la sección. */
  id?: string;
}

const { kicker, title, intro, id } = Astro.props;
---

<div class="mx-auto max-w-2xl text-center">
  <p class="mb-3 inline-flex items-center gap-2 text-xs font-bold tracking-[0.2em] text-leaf-400 uppercase">
    <span aria-hidden="true" class="h-px w-6 bg-leaf-400"></span>
    {kicker}
    <span aria-hidden="true" class="h-px w-6 bg-leaf-400"></span>
  </p>
  <h2 id={id} class="font-display text-4xl tracking-wide uppercase sm:text-5xl">{title}</h2>
  {intro && <p class="mt-4 text-base leading-relaxed text-white/70">{intro}</p>}
</div>
