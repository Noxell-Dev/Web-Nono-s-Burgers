---
import { t } from '../i18n/es';
---

<section id="inicio" class="relative overflow-hidden pt-28 pb-16 sm:pt-36 sm:pb-24">
  {/* Resplandor decorativo */}
  <div aria-hidden="true" class="pointer-events-none absolute -top-32 left-1/2 h-96 w-[42rem] -translate-x-1/2 rounded-full bg-yolk-400/10 blur-3xl"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-2">
    <div>
      <h1 class="font-display text-5xl leading-[1.05] tracking-wide uppercase sm:text-6xl lg:text-7xl">
        {t.hero.titleStart}{' '}
        <span class="text-yolk-400">{t.hero.titleAccent}</span>
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/70">
        {t.hero.subtitle}
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={t.hero.primaryCtaHref}
          class="inline-flex items-center gap-2 rounded-full bg-yolk-400 px-7 py-3.5 text-base font-bold text-coal-950 transition-transform hover:scale-105"
        >
          {t.hero.primaryCta}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14M5 12l7 7 7-7" />
          </svg>
        </a>
        <a
          href={t.hero.secondaryCtaHref}
          class="inline-flex items-center gap-2 rounded-full border border-white/20 px-7 py-3.5 text-base font-bold text-white transition-colors hover:border-yolk-400 hover:text-yolk-400"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          {t.hero.secondaryCta}
        </a>
      </div>
      <div class="mt-8 inline-flex items-center gap-4 rounded-2xl border border-yolk-400/30 bg-yolk-400/10 px-5 py-4">
        <span aria-hidden="true" class="font-display text-3xl text-yolk-400">2'90€</span>
        <div>
          <p class="font-display text-lg tracking-wide uppercase">{t.hero.dealTitle}</p>
          <p class="text-sm text-white/70">{t.hero.dealText}</p>
        </div>
      </div>
    </div>

    <div class="relative mx-auto">
      <div aria-hidden="true" class="absolute inset-0 -z-10 scale-110 rounded-full bg-yolk-400/15 blur-3xl"></div>
      <img
        src="/images/logo.jpg"
        width="440"
        height="440"
        alt={t.hero.logoAlt}
        fetchpriority="high"
        class="h-64 w-64 rounded-full border-4 border-yolk-400/60 object-cover shadow-2xl shadow-black/60 sm:h-80 sm:w-80 lg:h-96 lg:w-96"
      />
    </div>
  </div>
</section>
