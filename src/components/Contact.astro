---
import { t } from '../i18n/es';
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';
import SocialLinks from './SocialLinks.astro';
---

<section id="contacto" aria-labelledby="contacto-heading" class="bg-coal-900 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading
      id="contacto-heading"
      kicker={t.contact.kicker}
      title={t.contact.title}
      intro={t.contact.intro}
    />

    <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
      {/* Pedidos */}
      <div class="rounded-2xl border border-yolk-400/25 bg-coal-950 p-7">
        <h3 class="font-display text-2xl tracking-wide uppercase">Pide por teléfono</h3>
        <ul class="mt-6 space-y-5">
          {site.phones.map((phone) => (
            <li class="rounded-xl border border-white/10 p-4">
              <p class="font-display text-xl tracking-wide text-yolk-400">{phone.display}</p>
              <div class="mt-3 flex flex-wrap gap-3">
                <a
                  href={phone.href}
                  class="inline-flex items-center gap-2 rounded-full bg-yolk-400 px-5 py-2.5 text-sm font-bold text-coal-950 transition-transform hover:scale-105"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                  {t.contact.callLabel}
                </a>
                <a
                  href={phone.whatsapp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-full border border-leaf-400/50 px-5 py-2.5 text-sm font-bold text-leaf-300 transition-colors hover:bg-leaf-400/10"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                  </svg>
                  {t.contact.whatsappLabel}
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>

      {/* Dirección */}
      <div class="rounded-2xl border border-white/10 bg-coal-950 p-7">
        <h3 class="font-display text-2xl tracking-wide uppercase">{t.contact.addressTitle}</h3>
        <address class="mt-6 leading-relaxed text-white/75 not-italic">
          {site.address.street}<br />
          {site.address.postalCode} {site.address.locality} ({site.address.region})
        </address>
        <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-leaf-400/10 px-4 py-2 text-sm font-bold text-leaf-300">
          Domicilio: {site.deliveryFee}
        </p>
        <div class="mt-6">
          <a
            href={site.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 px-5 py-2.5 text-sm font-bold text-white transition-colors hover:border-yolk-400 hover:text-yolk-400"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            {t.contact.addressMapsLabel}
          </a>
        </div>
        <div class="mt-6 border-t border-white/10 pt-6">
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center gap-2 font-bold break-all text-white/80 transition-colors hover:text-yolk-400"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
            {site.email}
          </a>
        </div>
        <div class="mt-8 border-t border-white/10 pt-6">
          <h4 class="mb-4 text-sm font-bold tracking-[0.18em] text-white/60 uppercase">{t.contact.socialTitle}</h4>
          <SocialLinks showHandle />
        </div>
      </div>
    </div>
  </div>
</section>
