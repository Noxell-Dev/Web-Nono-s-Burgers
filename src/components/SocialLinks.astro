---
import { site } from '../data/site';

interface Props {
  /** Tamaño de los iconos en px. */
  size?: number;
  /** Mostrar también el handle junto al icono. */
  showHandle?: boolean;
}

const { size = 20, showHandle = false } = Astro.props;
const iconClass = 'shrink-0';
---

<ul class="flex flex-wrap items-center gap-3">
  {site.social.map((s) => (
    <li>
      <a
        href={s.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${s.label} de ${site.name}: ${s.handle}`}
        class="inline-flex items-center gap-2 rounded-full border border-white/15 px-4 py-2.5 text-sm font-medium text-white/80 transition-colors hover:border-yolk-400 hover:text-yolk-400"
      >
        {s.label === 'TikTok' && (
          <svg class={iconClass} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 12a4 4 0 1 0 4 4V4c.6 2.5 2.4 4.3 5 4.5" />
          </svg>
        )}
        {s.label === 'Facebook' && (
          <svg class={iconClass} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
          </svg>
        )}
        {s.label === 'Instagram' && (
          <svg class={iconClass} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none" />
          </svg>
        )}
        {showHandle ? s.handle : s.label}
      </a>
    </li>
  ))}
</ul>
