---
import { t } from '../i18n/es';
import SectionHeading from './SectionHeading.astro';

const iconClass = 'h-8 w-8 text-yolk-400';
---

<section aria-labelledby="servicios-heading" class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading
      id="servicios-heading"
      kicker={t.highlights.kicker}
      title={t.highlights.title}
      intro={t.highlights.intro}
    />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {t.highlights.items.map((item) => (
        <article class="group rounded-2xl border border-white/10 bg-coal-900 p-7 transition-colors hover:border-yolk-400/50">
          <div class="mb-5 inline-flex rounded-xl bg-yolk-400/10 p-3">
            {item.icon === 'menu' && (
              <svg class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
              </svg>
            )}
            {item.icon === 'ticket' && (
              <svg class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z" />
                <path d="M13 5v2" />
                <path d="M13 11v2" />
                <path d="M13 17v2" />
              </svg>
            )}
            {item.icon === 'bike' && (
              <svg class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="18.5" cy="17.5" r="3.5" />
                <circle cx="5.5" cy="17.5" r="3.5" />
                <circle cx="15" cy="5" r="1" />
                <path d="M12 17.5V14l-3-3 4-3 2 3h2" />
              </svg>
            )}
          </div>
          <h3 class="font-display text-2xl tracking-wide uppercase">{item.title}</h3>
          <p class="mt-3 leading-relaxed text-white/65">{item.text}</p>
          {'linkLabel' in item && item.linkLabel && (
            <a
              href={item.linkHref}
              class="mt-5 inline-flex items-center gap-2 font-bold text-yolk-400 hover:underline"
            >
              {item.linkLabel}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
